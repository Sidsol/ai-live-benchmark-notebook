# Copy this file to .env and add local credentials.

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Optional: override these with API model IDs enabled for your provider accounts.
AIMBT_OPENAI_MODEL_NAME=gpt-5.5
AIMBT_ANTHROPIC_MODEL_NAME=claude-opus-4-7
AIMBT_GOOGLE_MODEL_NAME=gemini-3.1

# Optional: use a positive integer or "all".
AIMBT_LIVE_PROMPT_CASE_LIMIT=all

# Optional scenario settings.
AIMBT_PROVIDER_TIMEOUT_SECONDS=120
AIMBT_LATENCY_TARGET_MS=8000

# Optional framework integrations.
# MLflow logs locally to ./mlruns by default and does not call provider APIs itself.
AIMBT_ENABLE_MLFLOW=true
AIMBT_MLFLOW_EXPERIMENT_NAME=ai-live-benchmark-notebook
AIMBT_MLFLOW_TRACKING_URI=

# RAGAS can trigger extra evaluator LLM calls. Keep false until you want those extra eval costs.
AIMBT_RUN_RAGAS_EVALS=false
AIMBT_RAGAS_EVAL_LIMIT=3

# DSPy can trigger extra optimizer/prompt-program LLM calls. Keep false until you want those extra eval costs.
AIMBT_RUN_DSPY_EVALS=false
AIMBT_DSPY_EVAL_LIMIT=3
AIMBT_DSPY_MODEL_NAME=gpt-5.5
